# Root .gitignore for Java (Maven) + Vite/React monorepo

# -----------------
# Node/Frontend
# -----------------
node_modules/
# package managers logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# Ignore root package files only; keep frontend/package-lock.json tracked
/package-lock.json
/package.json

# Vite/React build outputs
# Vite default output
**/dist/
# Generic build directories
**/build/

# Caches
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# TypeScript
*.tsbuildinfo

# Legacy/bundlers (harmless to keep ignored)
web_modules/
jspm_packages/
.lock-wscript
build/Release/

# DO NOT ignore public assets (removed the old 'public' rule)
# If you ever need to ignore a specific generated public directory, scope it explicitly, e.g.:
# frontend/some-tool-public/

# -----------------
# Environment files
# -----------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow example env files to be committed
!.env.example

# -----------------
# Coverage
# -----------------
coverage/
*.lcov
.nyc_output/

# -----------------
# Logs & runtime data
# -----------------
logs/
*.log
pids/
*.pid
*.pid.lock
*.seed

# -----------------
# Java / Maven
# -----------------
*.class
# Allow JAR files in lib directories if needed
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven build
**/target/

# Maven metadata
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# -----------------
# IDEs / Editors
# -----------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Eclipse
.project
.classpath
.settings/
bin/

# NetBeans
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# Sublime
*.sublime-project
*.sublime-workspace

# -----------------
# Frameworks (harmless extra ignores)
# -----------------
.next/
.nuxt/
.storybook-out/
.out/

# -----------------
# OS-specific
# -----------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -----------------
# Temporary / swap / backups
# -----------------
.tmp/
tmp/
temp/
*.swp
*.swo
*.bak
*.backup
*.old

# -----------------
# Databases & dumps
# -----------------
*.sqlite
*.db
# Do NOT ignore *.sql so that migration scripts can be committed
# If you want to exclude dumps, prefer a narrower pattern like:
# *.dump.sql

# -----------------
# Firebase
# -----------------
.firebase/
firebase-debug.log
# .firebaserc is allowed to be committed; remove from ignore to avoid blocking CI/deploy configs

# -----------------
# Spring Boot
# -----------------
*.logs
spring.log

# -----------------
# Docker
# -----------------
# Keep .dockerignore tracked (removed from ignore)

# -----------------
# Liquibase
# -----------------
liquibase.properties

# -----------------
# Scratch / test files
# -----------------
scrape.js
spotify_api.js
test.html
test2.html
test_cors.js
test_yt.html

# -----------------
# Analysis / notes (local only)
# -----------------
PROJECT_FLAWS_ANALYSIS.md
ANALYSIS_REPORT.md