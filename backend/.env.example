# Backend environment file. Copy to `backend/.env` (loaded by docker-compose via env_file).
# Under Docker Compose these keys are set by docker-compose.yml and ignored here:
#   DB_URL, DB_USERNAME, DB_PASSWORD (from the root .env), VALKEY_HOST, VALKEY_PORT,
#   CORS_ALLOWED_ORIGINS (from the root .env) and SERVER_PORT (always 8080).
# Spring Boot does not read .env files itself: when running the backend directly with Maven,
# export these as environment variables instead.

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/bracket_battle
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Valkey / Redis (defaults to localhost:6379)
# VALKEY_HOST=localhost
# VALKEY_PORT=6379
# VALKEY_PASSWORD=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin credentials (required; the backend refuses to start without one of these)
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
# Base64-encoded JSON is safest (Compose env files can't hold multi-line values); raw JSON
# works only on a single line:
FIREBASE_CREDENTIALS_JSON=
# ...or a path to the JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
