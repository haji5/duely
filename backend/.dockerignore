# Maven build output (the image builds the jar itself)
target/

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
bin/
out/

# Version control
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/

# Environment files (secrets are passed at runtime, never baked into the image)
.env
.env.*

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
