<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="bracket-battle">
        <createTable tableName="brackets">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="bracket-battle">
        <createTable tableName="items">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bracket_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="media_url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="media_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="items"
            baseColumnNames="bracket_id"
            constraintName="fk_items_bracket"
            referencedTableName="brackets"
            referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="3" author="bracket-battle">
        <createTable tableName="results">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bracket_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)"/>
            <column name="ranking" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="results"
            baseColumnNames="bracket_id"
            constraintName="fk_results_bracket"
            referencedTableName="brackets"
            referencedColumnNames="id"/>
    </changeSet>

    <!-- Fix ranking column type to resolve Jackson serialization issues -->
    <changeSet id="6" author="bracket-battle">
        <modifyDataType tableName="results" columnName="ranking" newDataType="TEXT"/>
    </changeSet>

