<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Create brackets table -->
    <changeSet id="1" author="bracket-battle">
        <createTable tableName="brackets">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(100)" defaultValue="General">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Create items table -->
    <changeSet id="2" author="bracket-battle">
        <createTable tableName="items">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bracket_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="media_url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="media_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="items"
            baseColumnNames="bracket_id"
            constraintName="fk_items_bracket"
            referencedTableName="brackets"
            referencedColumnNames="id"/>
    </changeSet>

    <!-- Create results table -->
    <changeSet id="3" author="bracket-battle">
        <createTable tableName="results">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bracket_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)"/>
            <column name="ranking" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="true"/>
            </column>
            <column name="submission_token" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="results"
            baseColumnNames="bracket_id"
            constraintName="fk_results_bracket"
            referencedTableName="brackets"
            referencedColumnNames="id"/>
        <addUniqueConstraint
            tableName="results"
            columnNames="submission_token"
            constraintName="uq_results_submission_token"/>
        <createIndex indexName="idx_user_bracket_token"
                     tableName="results">
            <column name="user_id"/>
            <column name="bracket_id"/>
            <column name="submission_token"/>
        </createIndex>
    </changeSet>

    <!-- Add display name and comment to results -->
    <changeSet id="4" author="bracket-battle">
        <addColumn tableName="results">
            <column name="display_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="comment" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Earlier versions stored plain-text fields HTML-escaped (e.g. "Noah Kahan &amp; Hozier").
         Sanitizer now stores real characters, so decode the legacy rows. &amp; is decoded last
         so double-escaped values only lose one level. -->
    <changeSet id="5" author="bracket-battle">
        <sql>
            UPDATE items SET title = REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(title,
                '&amp;quot;', '"'), '&amp;#39;', ''''), '&amp;lt;', '&lt;'), '&amp;gt;', '&gt;'), '&amp;amp;', '&amp;')
            WHERE title LIKE '%&amp;%';
            UPDATE brackets SET name = REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(name,
                '&amp;quot;', '"'), '&amp;#39;', ''''), '&amp;lt;', '&lt;'), '&amp;gt;', '&gt;'), '&amp;amp;', '&amp;')
            WHERE name LIKE '%&amp;%';
            UPDATE brackets SET description = REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(description,
                '&amp;quot;', '"'), '&amp;#39;', ''''), '&amp;lt;', '&lt;'), '&amp;gt;', '&gt;'), '&amp;amp;', '&amp;')
            WHERE description LIKE '%&amp;%';
            UPDATE results SET display_name = REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(display_name,
                '&amp;quot;', '"'), '&amp;#39;', ''''), '&amp;lt;', '&lt;'), '&amp;gt;', '&gt;'), '&amp;amp;', '&amp;')
            WHERE display_name LIKE '%&amp;%';
            UPDATE results SET comment = REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(comment,
                '&amp;quot;', '"'), '&amp;#39;', ''''), '&amp;lt;', '&lt;'), '&amp;gt;', '&gt;'), '&amp;amp;', '&amp;')
            WHERE comment LIKE '%&amp;%';
        </sql>
    </changeSet>

    <!-- Foreign keys aren't indexed automatically in Postgres; every per-bracket lookup scanned. -->
    <changeSet id="6" author="bracket-battle">
        <createIndex indexName="idx_items_bracket" tableName="items">
            <column name="bracket_id"/>
        </createIndex>
        <createIndex indexName="idx_results_bracket_created" tableName="results">
            <column name="bracket_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- Incremental leaderboard aggregates, updated in the same transaction as each result. -->
    <changeSet id="7" author="bracket-battle">
        <createTable tableName="item_stats">
            <column name="item_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_item_stats_item" referencedTableName="items" referencedColumnNames="id"/>
            </column>
            <column name="bracket_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_item_stats_bracket" referencedTableName="brackets" referencedColumnNames="id"/>
            </column>
            <column name="times_ranked" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="score_sum" type="DOUBLE PRECISION" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="wins" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="matches" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_item_stats_bracket" tableName="item_stats">
            <column name="bracket_id"/>
        </createIndex>
    </changeSet>

    <!-- Backfill item_stats from existing results. Legacy runs have no recorded matches, so their
         wins/matches use the old position-based approximation (see the SQL file). -->
    <changeSet id="8" author="bracket-battle">
        <sqlFile path="sql/backfill-item-stats.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <!-- The real (non-bye) matches of each run, as JSON [{winnerId, loserId}]. Null for legacy runs. -->
    <changeSet id="9" author="bracket-battle">
        <addColumn tableName="results">
            <column name="matches" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Zone-aware timestamps. Existing values were written by containers running in UTC. -->
    <changeSet id="10" author="bracket-battle">
        <sql>
            ALTER TABLE brackets ALTER COLUMN created_at TYPE TIMESTAMP WITH TIME ZONE USING created_at AT TIME ZONE 'UTC';
            ALTER TABLE results ALTER COLUMN created_at TYPE TIMESTAMP WITH TIME ZONE USING created_at AT TIME ZONE 'UTC';
        </sql>
    </changeSet>

    <!-- "My brackets" filtered on created_by with no index, scanning every bracket per request. -->
    <changeSet id="11" author="bracket-battle">
        <createIndex indexName="idx_brackets_created_by" tableName="brackets">
            <column name="created_by"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- Every valid run is saved; only counted runs add to item_stats and the run count. Existing
         runs were all counted. -->
    <changeSet id="12" author="bracket-battle">
        <addColumn tableName="results">
            <column name="counted" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Small key/value table for application state, e.g. the leaderboard scoring version. Version
         1 is the list-position scoring every existing item_stats row was built with; on startup the
         application rebuilds item_stats when its own version is newer (StatsService). -->
    <changeSet id="13" author="bracket-battle">
        <createTable tableName="app_meta">
            <column name="meta_key" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meta_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="app_meta">
            <column name="meta_key" value="stats_version"/>
            <column name="meta_value" value="1"/>
        </insert>
    </changeSet>

    <!-- Moderation and ownership. A hidden bracket is gone for everyone but its owner and admins.
         Deleting a bracket takes its entries, runs and leaderboard with it, so the foreign keys
         cascade. Reports point at a bracket or a comment (a result id); the target may be gone by
         the time someone looks, so target_id is not a foreign key. -->
    <changeSet id="14" author="bracket-battle">
        <addColumn tableName="brackets">
            <column name="hidden_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <dropForeignKeyConstraint baseTableName="items" constraintName="fk_items_bracket"/>
        <addForeignKeyConstraint baseTableName="items" baseColumnNames="bracket_id" constraintName="fk_items_bracket"
                                 referencedTableName="brackets" referencedColumnNames="id" onDelete="CASCADE"/>
        <dropForeignKeyConstraint baseTableName="results" constraintName="fk_results_bracket"/>
        <addForeignKeyConstraint baseTableName="results" baseColumnNames="bracket_id" constraintName="fk_results_bracket"
                                 referencedTableName="brackets" referencedColumnNames="id" onDelete="CASCADE"/>
        <dropForeignKeyConstraint baseTableName="item_stats" constraintName="fk_item_stats_bracket"/>
        <addForeignKeyConstraint baseTableName="item_stats" baseColumnNames="bracket_id" constraintName="fk_item_stats_bracket"
                                 referencedTableName="brackets" referencedColumnNames="id" onDelete="CASCADE"/>
        <dropForeignKeyConstraint baseTableName="item_stats" constraintName="fk_item_stats_item"/>
        <addForeignKeyConstraint baseTableName="item_stats" baseColumnNames="item_id" constraintName="fk_item_stats_item"
                                 referencedTableName="items" referencedColumnNames="id" onDelete="CASCADE"/>

        <createTable tableName="reports">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="target_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="details" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="reporter_uid" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="resolved_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE reports ADD CONSTRAINT ck_reports_target_type CHECK (target_type IN ('bracket', 'comment'));
            -- The moderation queue: open reports, newest first.
            CREATE INDEX idx_reports_open ON reports (created_at DESC, id DESC) WHERE resolved_at IS NULL;
        </sql>
        <createIndex indexName="idx_reports_target" tableName="reports">
            <column name="target_type"/>
            <column name="target_id"/>
        </createIndex>
        <createIndex indexName="idx_reports_reporter" tableName="reports">
            <column name="reporter_uid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
