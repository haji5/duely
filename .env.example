# Root environment file used by docker-compose.yml.
# Copy to `.env` and fill in the values:  cp .env.example .env

# Database (the hostname `postgres` is the Docker Compose service name)
DB_URL=jdbc:postgresql://postgres:5432/bracket_battle
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Backend port published on 127.0.0.1
SERVER_PORT=8080

# Origins allowed to call the API directly (the nginx /api proxy is same-origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase web app config (Firebase Console -> Project settings -> General -> Your apps)
# These are public client identifiers and are baked into the frontend bundle at build time.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
