# Root environment file used by docker-compose.yml.
# Copy to `.env` and fill in the values:  cp .env.example .env

# Database (the hostname `postgres` is the Docker Compose service name)
DB_URL=jdbc:postgresql://postgres:5432/bracket_battle
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Host port where the backend is published on 127.0.0.1 (inside Docker it always listens on 8080)
BACKEND_HOST_PORT=8080

# Browser origins allowed to call the API cross-origin. Pages served by nginx (localhost, LAN,
# Cloudflare tunnel) call /api same-origin and need no entry.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase web app config (Firebase Console -> Project settings -> General -> Your apps)
# These are public client identifiers and are baked into the frontend bundle at build time.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Public origin: canonicals, link previews, the sitemap, robots.txt and share links. Required by
# docker-compose.prod.yml (which refuses localhost); leave unset for development.
# PUBLIC_BASE_URL=https://duely.example

# nginx trusts the client address in X-Forwarded-For only from these (comma-separated, CIDRs
# allowed). Development defaults to the quick tunnel's 172.29.53.250; docker-compose.tunnel.yml
# sets its own. Behind a provider's load balancer, its address range.
# TRUSTED_PROXIES=10.0.0.0/16
# REAL_IP_HEADER=X-Forwarded-For

# ---- Production (docker-compose.prod.yml; see "Running it publicly" in the README) ----
# Image tag to run: a release (git tag v1.2.0 publishes 1.2.0) or a commit sha.
# DUELY_TAG=1.0.0
# Where nginx is published on the host (loopback unless the proxy is on another machine).
# HTTP_BIND=127.0.0.1
# HTTP_PORT=3000
# The named tunnel's token (docker-compose.tunnel.yml).
# CLOUDFLARE_TUNNEL_TOKEN=
# Nightly pg_dump: directory, time of day (in TZ), days kept, and a script run after each dump.
# BACKUP_DIR=./backups
# BACKUP_TIME=03:30
# TZ=UTC
# BACKUP_KEEP_DAYS=14
# BACKUP_HOOK=
